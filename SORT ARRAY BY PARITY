 class Solution {
    public int[] sortArrayByParity(int[] nums) {

        int left = 0;
        int right = nums.length - 1;

        while (left < right) {

            // Move left while the number is even
            while (left < right && nums[left] % 2 == 0) {
                left++;
            }

            // Move right while the number is odd
            while (left < right && nums[right] % 2 != 0) {
                right--;
            }

            // Swap odd and even numbers
            if (left < right) {
                int temp = nums[left];
                nums[left] = nums[right];
                nums[right] = temp;
            }
        }

        return nums;
    }
}
